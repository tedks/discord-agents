load("@rules_foreign_cc//foreign_cc:configure.bzl", "configure_make")

package(default_visibility = ["//visibility:private"])

# OCaml 5.5's relative library directory lets the installed compiler and
# standard library remain together; remote action portability is still open.
configure_make(
    name = "ocaml_compiler",
    # OCaml's release archive carries its root Makefile; configure only
    # generates Makefile.build_config, so make must run in that source tree.
    configure_in_place = True,
    configure_options = [
        "--with-relative-libdir",
        "--disable-native-compiler",
        "--without-zstd",
        "--disable-warn-error",
    ],
    lib_source = "@ocaml_source//:sources",
    out_binaries = [
        "ocamlc",
        "ocamlrun",
    ],
    out_data_dirs = ["lib/ocaml"],
    targets = [
        "world",
        "install",
    ],
    visibility = [
        "//bazel:__pkg__",
        "//lib:__pkg__",
        "//test:__pkg__",
        "//third_party:__pkg__",
    ],
)
